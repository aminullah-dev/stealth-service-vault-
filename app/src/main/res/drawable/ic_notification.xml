<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar notification icon: the SafeBeauty bloom as a flat white-on-
  transparent silhouette.

  Android draws a notification's small icon using ONLY its alpha channel and
  tints the result, so any icon with an opaque background flattens to a solid
  white square (which is what @mipmap/ic_launcher was doing). Everything here is
  therefore a single opaque colour on a transparent canvas, with the flower's
  inner detail punched out as real transparency rather than painted white —
  otherwise the cut-outs would vanish once the alpha mask is applied.

  Derived from ic_launcher_monochrome.xml, scaled from a 108dp launcher canvas
  to the 24dp notification canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stem + leaves -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M53,66 h2 v16 h-2 z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M51.00,78.00 Q44.94,68.34 34.09,71.84 Q40.15,81.50 51.00,78.00 Z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M57.00,78.00 Q67.85,81.50 73.91,71.84 Q63.06,68.34 57.00,78.00 Z" />

    <!-- Bloom, with the inner swirl removed as a hole (evenOdd) so the shape
         still reads as a flower after the system applies the alpha mask. -->
    <path android:fillColor="#FFFFFFFF" android:fillType="evenOdd"
        android:pathData="M70.00,50.00 C80.73,53.80 75.59,66.21 65.31,61.31 C70.21,71.59 57.80,76.73 54.00,66.00 C50.20,76.73 37.79,71.59 42.69,61.31 C32.41,66.21 27.27,53.80 38.00,50.00 C27.27,46.20 32.41,33.79 42.69,38.69 C37.79,28.41 50.20,23.27 54.00,34.00 C57.80,23.27 70.21,28.41 65.31,38.69 C75.59,33.79 80.73,46.20 70.00,50.00 Z M60.89,51.22 C67.09,54.97 61.17,62.03 56.39,56.58 C56.24,63.82 47.17,62.22 49.50,55.36 C43.15,58.85 40.00,50.20 47.11,48.78 C40.91,45.03 46.83,37.97 51.61,43.42 C51.76,36.18 60.83,37.78 58.50,44.64 C64.85,41.15 68.00,49.80 60.89,51.22 Z" />
</vector>
