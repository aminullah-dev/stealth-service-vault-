rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // The app's own uid scheme (the client-generated UUID that is the actual
    // users/{uid} document ID — see RegisterViewModel) is NOT the same value
    // as request.auth.uid (Firebase Auth's own, separately-generated uid).
    // uid_map/{request.auth.uid} bridges the two (written by syncUidMap /
    // resolveAppUser in Cloud Functions right after sign-in) so every rule
    // below that compares against a stored customerId/providerId/etc. — all
    // of which are the app-level uid — resolves correctly.
    function me() {
      return get(/databases/$(database)/documents/uid_map/$(request.auth.uid)).data.appUid;
    }

    function myData() {
      return get(/databases/$(database)/documents/users/$(me())).data;
    }

    function isAdmin() {
      return isSignedIn() && myData().role == 'ADMIN';
    }

    function isProvider() {
      return isSignedIn() && myData().role == 'PROVIDER';
    }

    function isCustomer() {
      return isSignedIn() && myData().role == 'CUSTOMER';
    }

    // Approved AND not suspended. These were two separate ideas written into
    // two separate fields, and this function only knew about one of them: an
    // account suspended through adminSuspendUser (which writes `suspended`)
    // kept every direct write this gates -- creating salons, services, offers,
    // posts, reviews -- because its `status` was still APPROVED. The callables
    // refused it and the rules waved it through. See isSuspended() in
    // functions/shared.js, which is the same check on the other side.
    function isApproved() {
      return isSignedIn()
          && myData().status == 'APPROVED'
          && myData().get('suspended', false) == false;
    }

    function ownsDoc(uid) {
      return isSignedIn() && me() == uid;
    }

    // Returns true if the current user is the provider who owns [salonId].
    function ownsThisSalon(salonId) {
      return isProvider()
          && get(/databases/$(database)/documents/salons/$(salonId)).data.providerId == me();
    }

    // conversationId format: "{customerId}_{salonId}"
    // Returns true if the current user is the customer OR the salon's provider.
    function isParticipantInConversation(conversationId) {
      let parts = conversationId.split('_');
      return parts.size() >= 2
          && (parts[0] == me()
              || get(/databases/$(database)/documents/salons/$(parts[1])).data.providerId == me());
    }

    // A support thread ("support_{userId}") between one user and the platform
    // admin. Kept separate from isParticipantInConversation so it never runs the
    // salon lookup that function does (parts[1] here is a user id, not a salon).
    function isSupportConversation(conversationId) {
      return conversationId.split('_')[0] == 'support';
    }
    function isSupportParticipant(conversationId) {
      let parts = conversationId.split('_');
      return parts.size() == 2 && (isAdmin() || parts[1] == me());
    }

    // ── users ──────────────────────────────────────────────────────────────────
    //
    // Login and the pre-auth phone lookup are now Cloud Functions
    // (authenticateWithPin / lookupAccountByPhone) that run with the Admin SDK
    // and bypass these rules. Clients therefore never need to read the users
    // collection pre-auth, so reads are locked down: a user may read only their
    // OWN document, and only an admin may list users. This closes the previous
    // hole where the entire credential table (every pinHash/salt) was readable.
    //
    match /users/{uid} {
      allow get:  if isSignedIn() && (ownsDoc(uid) || isAdmin());
      allow list: if isAdmin();

      // {uid} is a UUID generated at registration — by registerAccount on the
      // server for every account created since that callable landed, and by
      // the client before it. Independent of Firebase Auth's own uid, and
      // uid_map (which backs me()) can't be populated yet at this point
      // anyway, since it's only ever written by looking up an EXISTING
      // users/{uid} doc. So this can't check "me() == uid"; what actually
      // prevents hijacking someone else's profile is Firestore's own
      // create-vs-update semantics (this rule only ever fires for a document
      // that doesn't exist yet — a colliding UUID is cryptographically
      // negligible) plus the role/status constraints below. A self-registration
      // may ONLY be a CUSTOMER (auto-approved) or a PROVIDER (starts PENDING,
      // awaiting admin approval) — never an ADMIN, and a provider may not
      // self-approve. The first ADMIN is bootstrapped out-of-band (console /
      // setup), not through this path.
      // No client may create a users document. Registration is registerAccount
      // (Admin SDK, which bypasses these rules), and after that move the only
      // remaining caller of the client-side createUser was FirestoreSeeder,
      // whose isAdminMissing() read is denied by `allow list: if isAdmin()`
      // above and has therefore never reached its write.
      //
      // The long list of constraints this replaces did close the variant its
      // own comment described — a second document claiming someone else's
      // firebaseEmail — but only that one. Two fields it never constrained were
      // `phone` and the DOCUMENT ID, and both server resolvers break ties by
      // ascending __name__ on a limit(1) with no orderBy:
      //
      //   shared.js   users.where('firebaseEmail','==',token.email).limit(1)
      //   identity.js users.where('phone','==',…).limit(1)
      //
      // So a signed-in customer could create users/! or users/0 — any id
      // sorting below a UUID — carrying their OWN firebaseEmail, which
      // satisfied every condition here, and:
      //
      //   * escape a suspension, since a suspended account can still sign in
      //     and the new document carries status APPROVED and a clean
      //     noShowCount, and resolveAppUser then returns it for every callable;
      //   * put a VICTIM's phone number on it and lock her out permanently —
      //     authenticateWithPassword resolves the plant first, so her password
      //     is checked against the attacker's hash and always fails, while
      //     findAccountByPhone hands password recovery the attacker's address;
      //   * claim another account's referralCode, which is frozen on update and
      //     was unconstrained here, and collect its credit;
      //   * and choose an id like `x" onfocus=…`, which the admin console wrote
      //     unescaped into a data attribute — stored XSS in a live admin
      //     session, from any customer account.
      //
      // None of that needed a second constraint. It needed this rule to stop
      // existing, which it now has.
      allow create: if false;

      // Users can update their own profile; admins can change status / verify.
      // A self-update may NOT change privileged fields — role and status are
      // admin-controlled, and every KYC field is written only by the submitKyc /
      // reviewKyc Cloud Functions (Admin SDK), so a user can't self-approve their
      // own identity verification. Without these freezes any user could set
      // role='ADMIN', un-suspend themselves, or set kycStatus='APPROVED' by
      // writing their own doc. name/photo/loyaltyPoints/fcmToken stay editable.
      // .get(...) with a default keeps this working for older docs that predate
      // these fields (a bare access to a missing field would error and deny).
      allow update: if isAdmin()
                 || (ownsDoc(uid)
                     && request.resource.data.role   == resource.data.role
                     && request.resource.data.status == resource.data.status
                     && request.resource.data.get('kycStatus', 'NONE')
                          == resource.data.get('kycStatus', 'NONE')
                     && request.resource.data.get('kycRejectionReason', '')
                          == resource.data.get('kycRejectionReason', '')
                     && request.resource.data.get('tazkiraNumber', '')
                          == resource.data.get('tazkiraNumber', '')
                     && request.resource.data.get('tazkiraPhotoUrl', '')
                          == resource.data.get('tazkiraPhotoUrl', '')
                     && request.resource.data.get('selfiePhotoUrl', '')
                          == resource.data.get('selfiePhotoUrl', '')
                     && request.resource.data.get('tazkiraPhotoPath', '')
                          == resource.data.get('tazkiraPhotoPath', '')
                     && request.resource.data.get('selfiePhotoPath', '')
                          == resource.data.get('selfiePhotoPath', '')
                     && request.resource.data.get('addressProvince', '')
                          == resource.data.get('addressProvince', '')
                     && request.resource.data.get('addressDetail', '')
                          == resource.data.get('addressDetail', '')
                     // Admin-curated identity fields (birth year, tazkira
                     // issue/expiry) — written only by adminUpdateUser (Admin SDK).
                     && request.resource.data.get('birthYear', '')
                          == resource.data.get('birthYear', '')
                     && request.resource.data.get('tazkiraIssueDate', '')
                          == resource.data.get('tazkiraIssueDate', '')
                     && request.resource.data.get('tazkiraExpiryDate', '')
                          == resource.data.get('tazkiraExpiryDate', '')
                     // Referral balance/flags are server-controlled (reviewKyc /
                     // createPaymentSession) — frozen against self-edits. The code
                     // and who-referred-me are set once at registration and fixed.
                     && request.resource.data.get('referralCredit', 0)
                          == resource.data.get('referralCredit', 0)
                     && request.resource.data.get('referralRewarded', false)
                          == resource.data.get('referralRewarded', false)
                     && request.resource.data.get('referralCode', '')
                          == resource.data.get('referralCode', '')
                     && request.resource.data.get('referredBy', '')
                          == resource.data.get('referredBy', '')
                     // Customer-reputation aggregates are written only by the
                     // reportCustomer Cloud Function — frozen so a customer can't
                     // erase a bad rating or no-show off their own record.
                     && request.resource.data.get('customerRatingSum', 0)
                          == resource.data.get('customerRatingSum', 0)
                     && request.resource.data.get('customerRatingCount', 0)
                          == resource.data.get('customerRatingCount', 0)
                     && request.resource.data.get('noShowCount', 0)
                          == resource.data.get('noShowCount', 0)
                     // Written only by scheduled functions (completePastAppointments
                     // stamps lastVisitAt; sendReengagementNudges stamps lastNudgedAt).
                     && request.resource.data.get('lastVisitAt', 0)
                          == resource.data.get('lastVisitAt', 0)
                     && request.resource.data.get('lastNudgedAt', 0)
                          == resource.data.get('lastNudgedAt', 0)
                     // Set once by claimProfileReward when the profile-completion
                     // bonus is granted; frozen so it can't be reset to re-claim.
                     && request.resource.data.get('profileRewardClaimed', false)
                          == resource.data.get('profileRewardClaimed', false)
                     // loyaltyPoints is server-authoritative: confirmAppointment
                     // awards it and redeemLoyaltyPoints spends it into
                     // referralCredit (real checkout money). Frozen so a client
                     // can't mint points on its own doc and redeem them.
                     && request.resource.data.get('loyaltyPoints', 0)
                          == resource.data.get('loyaltyPoints', 0)
                     // phone is the login identifier; uniqueness is enforced only
                     // server-side at registration, so a self-edit could shadow
                     // another account's login resolution. Frozen post-signup.
                     && request.resource.data.get('phone', '')
                          == resource.data.get('phone', '')
                     // Set only by adminSetUserStatus. A suspension a user can
                     // lift is not a suspension, and the acting callables read
                     // this flag to decide whether to refuse.
                     && request.resource.data.get('suspended', false)
                          == resource.data.get('suspended', false)
                     && request.resource.data.get('suspendedReason', '')
                          == resource.data.get('suspendedReason', '')
                     // What the account's status was before it was suspended,
                     // so reinstating restores it instead of guessing APPROVED
                     // and promoting a provider who was still awaiting review.
                     // A client that could write it could choose its own
                     // reinstatement.
                     && request.resource.data.get('statusBeforeSuspension', '')
                          == resource.data.get('statusBeforeSuspension', '')
                     // The two derived lookup keys, written only by the
                     // deriveUserPhoneKey trigger. authenticateWithPassword
                     // resolves an account by phoneDigits, so a client that
                     // could write it could claim another account's key and
                     // lock its owner out — the password check would then run
                     // against the wrong record. nameKey is what the admin
                     // console searches by; a client that could choose it could
                     // make its own account unfindable, or surface under
                     // someone else's name.
                     && request.resource.data.get('phoneDigits', '')
                          == resource.data.get('phoneDigits', '')
                     && request.resource.data.get('nameKey', '')
                          == resource.data.get('nameKey', '')
                     // And the identity itself. Changing this on an existing doc
                     // is the same attack as planting a new one.
                     && request.resource.data.get('firebaseEmail', '')
                          == resource.data.get('firebaseEmail', '')
                     // The credential pair. This list is a denylist, so until
                     // these two lines existed the owner of a document could
                     // write them straight from the client SDK — no callable in
                     // the path, and therefore no proof of anything beyond
                     // holding a session.
                     //
                     // Writing them is not a takeover, it is a permanent
                     // lockout: pinHash and salt must agree with the Firebase
                     // Auth password derived from them, and only the server can
                     // change that. Overwrite the pair and BOTH passwords stop
                     // working — the new hash matches nothing Firebase will
                     // accept, and the real password no longer matches the
                     // hash. Only adminResetPassword recovers it.
                     //
                     // changePassword and updatePinHash are the only writers,
                     // and both now require a recent authentication.
                     && request.resource.data.get('pinHash', '')
                          == resource.data.get('pinHash', '')
                     && request.resource.data.get('salt', '')
                          == resource.data.get('salt', ''));

      allow delete: if isAdmin();
    }

    // ── salons ─────────────────────────────────────────────────────────────────
    match /salons/{salonId} {
      allow read: if isSignedIn();

      // Salons are created exclusively by the createProviderSalon Cloud Function
      // (Admin SDK bypasses these rules). It runs at registration — before the
      // uid_map bridge exists — so me() can't resolve here, and the providerId
      // must be set authoritatively server-side (to the app-level uid) rather
      // than trusted from the client.
      allow create: if false;

      // Provider can edit their own salon; admin can edit any.
      // A provider may NOT flip isVerified — the VERIFIED badge is a trust signal
      // granted only by an admin (setSalonVerified). Without this guard a provider
      // could self-award the badge to look legitimate.
      allow update: if isAdmin()
                 || (isProvider() && isApproved()
                     && resource.data.providerId == me()
                     && request.resource.data.providerId == resource.data.providerId
                     && request.resource.data.isVerified  == resource.data.isVerified
                     // Server-maintained reputation fields, frozen so a provider
                     // can't self-award a GOLD/SILVER badge (badge() thresholds on
                     // both) or a top rating: confirmedCount by confirmAppointment,
                     // and rating by the awardReviewPoints review trigger.
                     && request.resource.data.get('foundingSalon', false)
                          == resource.data.get('foundingSalon', false)
                     && request.resource.data.get('confirmedCount', 0)
                          == resource.data.get('confirmedCount', 0)
                     && request.resource.data.get('rating', 0)
                          == resource.data.get('rating', 0)
                     // Discovery fields, derived by deriveSalonFields from what
                     // the salon actually typed into `services` and `district`.
                     // A salon that could write these directly could file itself
                     // under every category and every neighbourhood, which is
                     // exactly what ranking and filtering exist to prevent.
                     // Editing services/district is still free — the trigger
                     // re-derives from them.
                     && request.resource.data.get('categories', [])
                          == resource.data.get('categories', [])
                     && request.resource.data.get('districtKey', '')
                          == resource.data.get('districtKey', '')
                     // And the flag saying a person should look at this salon.
                     // One that could clear its own would simply vanish from the
                     // admin's review queue while staying unfindable.
                     && request.resource.data.get('needsDiscoveryReview', false)
                          == resource.data.get('needsDiscoveryReview', false)
                     && request.resource.data.get('discoveryReview', {})
                          == resource.data.get('discoveryReview', {})
                     // How dependably this salon answers its bookings, counted
                     // by measureSalonReliability from what it actually did. A
                     // salon that could write its own record would write a
                     // perfect one.
                     && request.resource.data.get('reliability', {})
                          == resource.data.get('reliability', {}));

      allow delete: if isAdmin()
                 || (isProvider() && resource.data.providerId == me());
    }

    // ── appointments ───────────────────────────────────────────────────────────
    match /appointments/{apptId} {
      // Readable only by the customer who booked, the salon's provider, or admin.
      allow read: if isSignedIn()
               && (resource.data.customerId == me()
                   || ownsThisSalon(resource.data.salonId)
                   || isAdmin());

      // Appointments are created exclusively by the createPaymentSession Cloud
      // Function (Admin SDK bypasses these rules). This enforces pay-first: a
      // client cannot create a booking without going through HesabPay payment.
      allow create: if false;

      // Every appointment mutation goes through a Cloud Function now —
      // confirmAppointment (provider), rescheduleAppointment (customer),
      // cancelAppointment / providerDeclineAppointment (paid-booking
      // cancellation with refund trail), and the payment webhook. The Admin
      // SDK bypasses these rules; clients have no direct write path left.
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ── chat_messages ──────────────────────────────────────────────────────────
    // conversationId = "{customerId}_{salonId}"
    // Messages are immutable once sent.
    match /chat_messages/{msgId} {
      allow read: if isSignedIn()
               && (isSupportConversation(resource.data.conversationId)
                     ? isSupportParticipant(resource.data.conversationId)
                     : isParticipantInConversation(resource.data.conversationId));

      // salonId is denormalised onto the message so the salon can QUERY its
      // own threads. Firestore cannot match a suffix, and the conversation id
      // is "{customerId}_{salonId}", so without this field a salon owner had
      // no way to list the conversations she is part of — which is why
      // messages were being written and never read by anyone.
      //
      // Constrained to the conversation's own salon, or a message could be
      // filed into another salon's inbox.
      allow create: if isSignedIn()
                 && request.resource.data.senderId == me()
                 && (isSupportConversation(request.resource.data.conversationId)
                       ? isSupportParticipant(request.resource.data.conversationId)
                       : (isParticipantInConversation(request.resource.data.conversationId)
                          && request.resource.data.get('salonId', '')
                               == request.resource.data.conversationId.split('_')[1]));

      allow update, delete: if false;
    }

    // ── support_tickets ─────────────────────────────────────────────────────────
    // One ticket per user (doc id = the user's app uid). The user upserts their
    // own ticket when they contact support; the admin reads all, clears the
    // unread flag, and closes resolved tickets.
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (ticketId == me() || isAdmin());
      allow create, update: if isSignedIn()
                 && ((ticketId == me() && request.resource.data.userId == me())
                     || isAdmin());
      allow delete: if isAdmin();
    }

    // ── reviews ────────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isSignedIn();

      // Reviews are created ONLY server-side via the submitReview callable, which
      // binds each review to a real, served appointment the caller owns (one per
      // booking). A direct client create is refused — otherwise a customer could
      // script unlimited reviews to farm loyalty points into wallet credit (real
      // money) and forge salon ratings.
      allow create: if false;

      // Provider may only add/edit their reply (no other fields may change).
      allow update: if (ownsThisSalon(resource.data.salonId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['providerReply', 'repliedAt']))
                 || isAdmin();

      allow delete: if isAdmin();
    }

    // ── salon_gallery ──────────────────────────────────────────────────────────
    // The storage object a media document may point at.
    //
    // storagePath is written by the client and later handed to a DELETE by two
    // privileged callers: the admin console's Remove button, which runs under
    // an admin token that storage.rules lets delete anything under kyc/,
    // salon_gallery/, salon_posts/, staff_portfolio/ and reviews/; and
    // cleanupExpiredStories, which uses the Admin SDK and so bypasses
    // storage.rules altogether. Unconstrained, an approved provider could point
    // her own post at "kyc/<rival>/tazkira.jpg" and have someone else's
    // identity document deleted for her — by an admin who is only trying to
    // take down an offensive photo.
    //
    // createSalonPost already checks exactly this shape server-side
    // (functions/domains/content.js). This is the same check on the path that
    // does not go through it.
    function ownsStoragePath(prefix, salonId, docId) {
      return request.resource.data.get('storagePath', '') ==
             prefix + '/' + salonId + '/' + docId + '.jpg';
    }

    match /salon_gallery/{imageId} {
      allow read: if isSignedIn();

      allow create: if isProvider() && isApproved()
                 && ownsThisSalon(request.resource.data.salonId)
                 && ownsStoragePath('salon_gallery', request.resource.data.salonId, imageId);

      // Images are replaced by delete + re-upload; no in-place edits.
      allow update: if false;

      allow delete: if ownsThisSalon(resource.data.salonId) || isAdmin();
    }

    // ── salon_offers ─────────────────────────────────────────────────────────
    // Provider-posted promotions, shown to customers. Informational only — they
    // never change the checkout price (the server recomputes amounts from
    // pricePerService), so a provider can freely edit the text/badge. Same
    // ownership model as salon_gallery; salonId is frozen on update.
    match /salon_offers/{offerId} {
      allow read: if isSignedIn();

      allow create: if isProvider() && isApproved()
                 && ownsThisSalon(request.resource.data.salonId);

      allow update: if isProvider() && isApproved()
                 && ownsThisSalon(resource.data.salonId)
                 && request.resource.data.salonId == resource.data.salonId;

      allow delete: if ownsThisSalon(resource.data.salonId) || isAdmin();
    }

    // ── salon_posts ──────────────────────────────────────────────────────────────
    // The social discovery feed: before/after & sample-work photos a salon shares.
    // Publicly readable to signed-in users (the feed); only the owning provider
    // posts, and only the owner or an admin can delete. Followers (favoriters) are
    // notified via the pushPostToFollowers trigger. Same ownership model as the
    // gallery; posts are immutable once created.
    match /salon_posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isProvider() && isApproved()
                 && ownsThisSalon(request.resource.data.salonId)
                 && ownsStoragePath('salon_posts', request.resource.data.salonId, postId);

      allow update: if false;

      allow delete: if ownsThisSalon(resource.data.salonId) || isAdmin();
    }

    // ── salon_stories ────────────────────────────────────────────────────────────
    // A salon's 24-hour announcement ("two chairs free this afternoon"). Same
    // ownership model as salon_posts. Readable by any signed-in user — unlike
    // offers, stories are NOT gated behind identity verification, because an
    // empty chair needs to reach the customers who have not verified yet.
    // Immutable once written: a story is a moment, and editing one after people
    // have acted on it would let a salon rewrite what it promised.
    match /salon_stories/{storyId} {
      allow read: if isSignedIn();

      allow create: if isProvider() && isApproved()
                 && ownsThisSalon(request.resource.data.salonId)
                 && ownsStoragePath('salon_stories', request.resource.data.salonId, storyId);

      allow update: if false;

      allow delete: if ownsThisSalon(resource.data.salonId) || isAdmin();
    }

    // ── appointment_events ───────────────────────────────────────────────────────
    // The history of one booking: who moved it to which state, when, and why.
    //
    // Written only by the Cloud Functions that perform the transitions (the
    // Admin SDK bypasses these rules), so there is no client create path at all
    // — a trail a client can append to is not evidence of anything.
    //
    // Readable by the two parties to the booking and by an admin. A customer
    // asking why her appointment was cancelled deserves the answer without
    // going through support.
    match /appointment_events/{eventId} {
      allow read: if isSignedIn()
               && (resource.data.customerId == me()
                   || ownsThisSalon(resource.data.salonId)
                   || isAdmin());
      allow create, update, delete: if false;
    }

    // ── booking_codes ────────────────────────────────────────────────────────────
    // One empty document per issued booking reference. It exists only so that
    // creating it fails when the code is taken, which is what makes a code
    // unique without a read-then-write two bookings could both pass.
    //
    // Never read by a client: a readable list of live codes would let anyone
    // guess their way to other people's bookings through adminLookupBooking's
    // input space.
    match /booking_codes/{code} {
      allow read, create, update, delete: if false;
    }

    // ── demand_signals ───────────────────────────────────────────────────────────
    // What customers looked for and did not get: an empty search, a slot that
    // was already taken, a checkout abandoned. It is the data that answers
    // "which salon should we recruit next", and it takes weeks to become useful,
    // which is why capture starts now and the analysis comes later.
    //
    // Deliberately carries NO identity. Not a customer id, not a hash of one.
    // The question is how much demand a district has for a service, and that is
    // answerable in aggregate — while a per-person record of what a woman in
    // Kabul searched for is exactly the kind of trail this platform should not
    // be accumulating. Nothing downstream needs it, so nothing writes it.
    //
    // Write-only from the client: a customer may append, and may not read the
    // collection back. A readable demand log would let anyone reconstruct which
    // neighbourhoods are searching for what, which is competitive intelligence
    // at best and a targeting list at worst.
    match /demand_signals/{signalId} {
      allow read: if isAdmin();

      allow create: if isSignedIn()
                 && request.resource.data.keys().hasOnly(
                      ['kind', 'districtKey', 'category', 'serviceName', 'salonId', 'lang', 'at'])
                 && request.resource.data.kind in ['NO_RESULTS', 'SLOT_TAKEN', 'CHECKOUT_ABANDONED']
                 && request.resource.data.at is int
                 // No identity fields, enforced rather than trusted: hasOnly
                 // above already refuses any key not on the list, so a future
                 // client cannot start attaching a uid without this rule failing.
                 && request.resource.data.get('districtKey', '').size() <= 64
                 && request.resource.data.get('category', '').size() <= 32
                 && request.resource.data.get('serviceName', '').size() <= 120;

      // Immutable and undeletable by clients. A signal that can be edited or
      // removed is not evidence of anything.
      allow update, delete: if false;
    }

    // ── post_likes ───────────────────────────────────────────────────────────────
    // The document id is "{postId}_{userId}", which makes a second like from the
    // same person impossible to write rather than merely discouraged.
    //
    // A liker's identity is deliberately not public. What a salon needs is the
    // count, and the count lives on the post itself, maintained by a trigger
    // running with the Admin SDK — so it cannot be inflated from a client, and
    // no client can list who liked a particular photo. A user reads only their
    // own likes, which is exactly enough to draw the heart filled.
    match /post_likes/{likeId} {
      allow read: if isSignedIn() && resource.data.userId == me();

      allow create: if isSignedIn()
                 && request.resource.data.userId == me()
                 && likeId == request.resource.data.postId + '_' + me();

      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == me();
    }

    // ── post_comments ────────────────────────────────────────────────────────────
    // Public, like the reviews a salon already carries, and signed with the same
    // stored name. The name is checked against the author's own user document so
    // a comment cannot be signed with somebody else's.
    match /post_comments/{commentId} {
      allow read: if isSignedIn();

      // salonId must be the one on the post this comment claims to be under.
      //
      // Delete authorises the moderator with resource.data.salonId, while the
      // app renders a thread by querying postId — two different fields, and
      // nothing tied them together. A comment carrying the target's postId and
      // somebody else's salonId therefore appeared under that salon's photo and
      // outside its owner's delete permission: unmoderatable by the one person
      // whose photo it sat on. Reading it through the post also forces postId
      // to name a real post, which was never checked either.
      //
      // createdAt is bounded for the same thread: it is what the client orders
      // by, so an arbitrary value pins a comment to the top of a conversation
      // it was not part of. A window, not an equality — FeedViewModel sends
      // System.currentTimeMillis() from the handset, and a device clock never
      // equals the server's to the millisecond, so `== request.time` would have
      // rejected every comment ever written. Five minutes each way tolerates a
      // badly-set phone and still leaves no room to pin.
      allow create: if isSignedIn()
                 && request.resource.data.userId == me()
                 && request.resource.data.authorName == myData().name
                 && request.resource.data.text is string
                 && request.resource.data.text.size() > 0
                 && request.resource.data.text.size() <= 300
                 && request.resource.data.salonId ==
                      get(/databases/$(database)/documents/salon_posts/$(request.resource.data.postId)).data.salonId
                 && request.resource.data.createdAt >= request.time.toMillis() - 300000
                 && request.resource.data.createdAt <= request.time.toMillis() + 300000;

      // Immutable, for the same reason a story is: editing a comment after
      // people have read or answered it rewrites a conversation they saw.
      allow update: if false;

      // The author can retract their own; the salon moderates the thread under
      // its own photo; the admin moderates anything.
      allow delete: if isSignedIn()
                 && (resource.data.userId == me()
                     || ownsThisSalon(resource.data.salonId)
                     || isAdmin());
    }

    // ── favorites ────────────────────────────────────────────────────────────────
    // A customer's favorited salons, mirrored from the on-device list so the
    // server can notify favoriters when their salon posts an offer (see
    // pushOfferToFavoriters). Doc id is "{customerId}_{salonId}". A customer only
    // ever reads/writes their own rows; the offer fan-out runs server-side.
    match /favorites/{favId} {
      allow read:   if isSignedIn() && (resource.data.customerId == me() || isAdmin());
      // The id is bound to the caller, not just the customerId field. Both
      // clients write favorites/{customerId}_{salonId}, and without this
      // anyone could create that exact id for someone ELSE — after which the
      // victim's own create is refused (the document exists, and update is
      // closed) and she can never favourite that salon, nor delete the row,
      // because deleting needs the customerId she does not have.
      allow create: if isSignedIn()
                 && request.resource.data.customerId == me()
                 && favId == me() + '_' + request.resource.data.salonId;
      allow delete: if isSignedIn() && resource.data.customerId == me();
      allow update: if false;
    }

    // ── gift_cards ─────────────────────────────────────────────────────────────
    // Bought via createGiftCardSession, settled by the HesabPay webhook (Admin
    // SDK). Buyer and recipient can read their own; nobody writes from a client.
    match /gift_cards/{giftId} {
      allow read: if isSignedIn()
               && (resource.data.buyerUid == me()
                   || resource.data.recipientUid == me()
                   || isAdmin());
      allow write: if false;
    }

    // ── broadcasts ─────────────────────────────────────────────────────────────
    match /broadcasts/{docId} {
      allow read:                    if isSignedIn();
      allow create, update, delete:  if isAdmin();
    }

    // ── waitlist ───────────────────────────────────────────────────────────────
    match /waitlist/{entryId} {
      allow read: if isSignedIn()
               && (resource.data.customerId == me()
                   || ownsThisSalon(resource.data.salonId)
                   || isAdmin());

      allow create: if isCustomer() && isApproved()
                 && request.resource.data.customerId == me();

      // Provider marks slot as available; admin can do anything.
      //
      // And the customer may dismiss her OWN entry, which she could not: the
      // Dismiss button on a SLOT_AVAILABLE card writes status EXPIRED
      // (FirestoreRepository.dismissWaitlistEntry) and this rule admitted only
      // the provider, so the button was denied every time and the card stayed.
      // Narrow on purpose — she may set her own entry to EXPIRED and change
      // nothing else, so this cannot be used to claim a slot by writing
      // SLOT_AVAILABLE to her own row.
      allow update: if ownsThisSalon(resource.data.salonId) || isAdmin()
                 || (resource.data.customerId == me()
                     && request.resource.data.status == 'EXPIRED'
                     && request.resource.data.customerId == resource.data.customerId
                     && request.resource.data.salonId == resource.data.salonId);

      allow delete: if resource.data.customerId == me() || isAdmin();
    }

    // ── notifications ──────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // Each user sees only their own notifications.
      allow read: if isSignedIn()
               && (resource.data.recipientId == me() || isAdmin());

      // Created exclusively by the Cloud Functions (Admin SDK bypasses these
      // rules). Every notification doc becomes a real FCM push
      // (pushOnNotificationCreated), so an open client create path would let
      // any signed-in user push arbitrary text to any user's phone.
      allow create: if false;

      // Only the recipient marks as READ. Not "the recipient may update".
      //
      // `create` is closed above with the reason spelled out — an open client
      // path would let anyone put arbitrary text in front of any user. Update
      // reopened exactly that: the recipient could rewrite title, body, type
      // AND recipientId, handing a notification she wrote herself to someone
      // else. It arrives without a push, since pushOnNotificationCreated fires
      // on create, but it sits in the victim's notification list in the app's
      // own voice, which is the part that makes it worth writing.
      //
      // Both clients write exactly this one field and nothing else:
      // FirestoreRepository.kt update("isRead", true) and
      // NotificationsRepository.swift updateData(["isRead": true]).
      allow update: if isAdmin()
                 || (resource.data.recipientId == me()
                     && request.resource.data.recipientId == resource.data.recipientId
                     && request.resource.data.get('title', '') == resource.data.get('title', '')
                     && request.resource.data.get('body', '')  == resource.data.get('body', '')
                     && request.resource.data.get('type', '')  == resource.data.get('type', '')
                     && request.resource.data.get('appointmentId', '')
                          == resource.data.get('appointmentId', '')
                     && request.resource.data.get('salonId', '')
                          == resource.data.get('salonId', '')
                     && request.resource.data.get('createdAt', 0)
                          == resource.data.get('createdAt', 0));
      allow delete: if resource.data.recipientId == me() || isAdmin();
    }

    // ── payments ─────────────────────────────────────────────────────────────
    // Written exclusively by the payment Cloud Functions (Admin SDK bypasses
    // these rules). Clients may only READ their own payment to observe status.
    match /payments/{paymentId} {
      allow read: if isSignedIn()
               && (resource.data.customerId == me()
                   || resource.data.providerId == me()
                   || isAdmin());
      allow write: if false;
    }

    // ── processed_webhooks ───────────────────────────────────────────────────────
    // Replay-guard ledger keyed by HesabPay transaction_id. Written exclusively
    // by the hesabPayWebhook Cloud Function (Admin SDK). No client access.
    match /processed_webhooks/{transactionId} {
      allow read, write: if false;
    }

    // ── refund_requests ─────────────────────────────────────────────────────────
    // Created exclusively by the cancelAppointment Cloud Function (Admin SDK)
    // when a customer cancels a PAID booking. The customer/provider involved can
    // see their own request; only admin can read all / will process it manually
    // (no automated HesabPay refund API is wired yet).
    match /refund_requests/{requestId} {
      allow read: if isSignedIn()
               && (resource.data.customerId == me()
                   || resource.data.providerId == me()
                   || isAdmin());
      allow write: if false;
    }

    // ── platform_config ────────────────────────────────────────────────────────
    // Global settings (e.g. commissionPercent). Readable by signed-in users;
    // writable only by admins. The payment function reads it server-side.
    match /platform_config/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── support_templates ───────────────────────────────────────────────────────
    // Canned support replies (welcome / guidance / …) the admin console offers to
    // copy or drop into a chat. Admin-only, both read and write — they're an
    // internal staff tool, never shown to customers or providers.
    match /support_templates/{templateId} {
      allow read, write: if isAdmin();
    }

    // ── admin_audit ─────────────────────────────────────────────────────────────
    // Tamper-evident log of privileged admin actions (password resets, balance
    // adjustments, admin grants…). Written exclusively by Cloud Functions (Admin
    // SDK); admins may read the trail but no one can write or alter it directly.
    // ── system_alerts / system_backups ──────────────────────────────────────────
    // What the nightly integrity sweep found, and whether each backup export
    // actually completed. Both written by Cloud Functions through the Admin SDK,
    // which bypasses these rules — so there was never a rule for either, and the
    // admin console's Health tab has therefore never been able to read them from
    // a browser. It reads both before rendering anything, so the whole tab failed
    // with "Missing or insufficient permissions", taking its repair tools down
    // with it. A page nobody can open is indistinguishable from a page nobody
    // needs, which is why this went unnoticed.
    //
    // Admin-only: they describe the platform's own health, and a backup listing
    // tells an attacker exactly when and where the data is written.
    match /system_alerts/{dayId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /system_backups/{runId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /admin_audit/{entryId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── provider_balances ───────────────────────────────────────────────────────
    // Ledger of what each provider is owed. Maintained by the webhook Cloud
    // Function; a provider may read only their own balance.
    // ── salon_stats ─────────────────────────────────────────────────────────────
    // A running tally of a salon's bookings — totals by status and by service —
    // maintained by the deriveSalonStats trigger so the provider's Income tab
    // does not have to read every appointment to count them.
    //
    // Read by the salon's own provider and by admins, not by everyone who can
    // read the salon. The salon document is public because customers browse it;
    // how many bookings it has taken, broken down by service, is the business's
    // own trading position.
    match /salon_stats/{salonId} {
      allow get: if isSignedIn() && (
                   isAdmin() ||
                   get(/databases/$(database)/documents/salons/$(salonId)).data.providerId == me()
                 );
      // No list: the tallies are looked up one salon at a time, and a listable
      // collection would hand every salon's volume to anyone who asked.
      allow list:  if false;
      allow write: if false;
    }

    match /provider_balances/{providerId} {
      allow read:  if ownsDoc(providerId) || isAdmin();
      allow write: if false;
    }

    // ── payouts ─────────────────────────────────────────────────────────────────
    // History of platform→provider payments. Written exclusively by the
    // recordProviderPayout Cloud Function (Admin SDK). A provider reads only
    // their own payouts; admins read all.
    match /payouts/{payoutId} {
      allow read:  if isSignedIn()
               && (resource.data.providerId == me() || isAdmin());
      allow write: if false;
    }

    // ── uid_map ─────────────────────────────────────────────────────────────────
    // Bridges request.auth.uid to the app's own uid scheme (see me()). Written
    // exclusively by syncUidMap / resolveAppUser (Admin SDK, Cloud Functions).
    // No client access — it's read only via the internal get() inside me(),
    // which is not subject to this (or any) document's own rules.
    match /uid_map/{authUid} {
      allow read, write: if false;
    }

    // ── promo_codes ──────────────────────────────────────────────────────────────
    // Discount codes. Only admins may read the list (the admin management screen);
    // customers never read them — they validate a code via the previewPromo /
    // createPaymentSession Cloud Functions, so codes can't be enumerated or
    // brute-forced from the client. All writes go through admin Cloud Functions.
    match /promo_codes/{code} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── customer_reports ─────────────────────────────────────────────────────────
    // A provider's post-appointment feedback about a customer (rating / no-show /
    // misconduct). Written exclusively by the reportCustomer Cloud Function. The
    // reporting provider may read their own reports; admins read all (to review
    // flagged misconduct). Customers can't read reports about themselves here —
    // their rating shows only as an aggregate on their user doc.
    match /customer_reports/{reportId} {
      allow read:  if isSignedIn()
               && (resource.data.providerId == me() || isAdmin());
      allow write: if false;
    }

    // ── visit_reports ────────────────────────────────────────────────────────────
    // A customer saying what happened at a visit — the mirror of
    // customer_reports, which has existed since this shipped and points the
    // other way. Written exclusively by reportVisit.
    //
    // She may read her own, so the app can show her that she already reported
    // this booking and what came of it. Admins read all, because the queue is
    // the point. The salon reads none: it can already see the booking, and
    // handing it the complaint before an admin has looked would put her in
    // front of the person she is complaining about.
    match /visit_reports/{reportId} {
      allow read:  if isSignedIn()
               && (resource.data.customerId == me() || isAdmin());
      allow write: if false;
    }

    // ── content_reports ──────────────────────────────────────────────────────────
    // Somebody flagging a post, story, comment or review. Written exclusively by
    // the reportContent callable, which is where the author of the reported
    // content is looked up — a client that could write this row could name
    // anybody as the author and get them suspended.
    //
    // The reporter may read her own reports so the app can show her that she has
    // already reported something; admins read all, because the queue is the
    // whole point. Nobody else, including the person reported: knowing who
    // reported you is how reporting becomes dangerous for the reporter, and in
    // this market that is not a theoretical concern.
    match /content_reports/{reportId} {
      allow read:  if isSignedIn()
               && (resource.data.reporterId == me() || isAdmin());
      allow write: if false;
    }

    // ── booking_claims ───────────────────────────────────────────────────────────
    // One document per booking request the app has made, keyed
    // {customerUid}_{clientRequestId}. createPaymentSession creates it before
    // it does anything and writes the result into it afterwards, so a retry
    // after a timeout gets that booking back instead of making a second one.
    //
    // Server-only in both directions. A client that could read these could
    // read another customer's booking result by guessing an id; one that could
    // write them could pre-claim an id to block her, or plant a `result` and
    // be handed a booking that was never made.
    match /booking_claims/{claimId} {
      allow read, write: if false;
    }

    // ── moderation_archive ───────────────────────────────────────────────────────
    // A copy of every piece of content an admin removed, taken the moment
    // before it was deleted. Written only by resolveContentReport.
    //
    // The content itself stays deleted — this restores no visibility. What it
    // restores is the ability to answer three questions that used to have no
    // answer: whether a removal was a mistake, what a salon disputing one was
    // actually accused of, and whether an account has done it before.
    //
    // Admins only. Not the author: handing back a copy of what was removed,
    // to the person it was removed from, is a way to hand them the reporter's
    // grounds as well.
    match /moderation_archive/{archiveId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── blocks ───────────────────────────────────────────────────────────────────
    // "I do not want to see this person." Client-written, because it is one
    // customer's own preference and affects nobody else's view — the apps filter
    // locally on it.
    //
    // The document id is "{blocker}_{blocked}", which makes a block written on
    // somebody else's behalf impossible to name rather than merely refused, and
    // makes unblocking a delete of a known id instead of a query.
    //
    // Read is the blocker's own only. A list of who has blocked a salon would be
    // a reputational fact the salon could act on, and a customer's block list is
    // a statement about people she is avoiding.
    match /blocks/{blockId} {
      allow read:   if isSignedIn() && resource.data.blockerId == me();
      allow create: if isSignedIn()
                 && request.resource.data.blockerId == me()
                 && request.resource.data.blockedId is string
                 && request.resource.data.blockedId.size() > 0
                 && request.resource.data.blockedId != me()
                 && blockId == me() + '_' + request.resource.data.blockedId
                 && request.resource.data.keys().hasOnly(
                      ['blockerId', 'blockedId', 'blockedKind', 'createdAt'])
                 // Required, not merely permitted. hasOnly says which keys MAY
                 // appear, not which must, and both apps list blocks with
                 // orderBy(createdAt) — an orderBy returns no document missing
                 // the field. A block written without it would filter content
                 // silently and never appear in the list that could lift it.
                 && request.resource.data.createdAt is number;
      // A block is created or removed, never edited: an editable block is a way
      // to point an existing row at a different person.
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.blockerId == me();
    }

    // ── rate_limits ──────────────────────────────────────────────────────────────
    // Abuse counters for the two pre-login callables (phone lookup, password
    // login). Server-only: a client that could read these would learn how close
    // it is to the limit, and one that could write them could reset its own
    // counter and defeat the throttle entirely. Unmatched paths are denied by
    // default, but this is stated explicitly so the intent survives future edits.
    match /rate_limits/{key} {
      allow read, write: if false;
    }
  }
}
