# ─── Gradle ──────────────────────────────────────────────────────────────────
.gradle/
build/
app/build/
**/build/

# ─── Android build artifacts ─────────────────────────────────────────────────
*.apk
*.aar
*.ap_
*.aab
*.dex
*.class
bin/
gen/
out/
release/

# Local NDK build output
obj/
.cxx/

# ─── Local config (machine-specific — never commit) ──────────────────────────
local.properties
keystore.properties

# ─── Android Studio / IntelliJ IDEA ──────────────────────────────────────────
.idea/
*.iml
.navigation/
captures/
.externalNativeBuild/

# ─── Signing / secrets (keep keystores & service keys out of the repo) ───────
*.jks
*.keystore
secrets.properties
# NOTE: app/google-services.json is intentionally NOT ignored — it is already
# committed and the build needs it. See the security note in the chat if you
# decide to move it out of version control.

# ─── Logs & temp files ───────────────────────────────────────────────────────
*.log
*.hprof
.DS_Store
Thumbs.db

# ─── Kotlin ──────────────────────────────────────────────────────────────────
.kotlin/

# ─── Claude Code ─────────────────────────────────────────────────────────────
# Local session state stays out; the agents and skills do not. They are project
# assets written to be shared — a cloud routine clones this repository and reads
# .claude/skills/ to learn the marketing safety rules, so an ignored skill is a
# routine that runs with no rules at all.
.claude/*
!.claude/agents/
!.claude/skills/

# What the last successful functions deploy shipped, per project. Local state:
# a teammate cannot know what your machine deployed, and a stale shared value
# would narrow the next deploy to nothing.
.firebase/functions-deployed-*

# The same argument for hosting. These are upload caches — one
# "filename,mtime,hash" line per file, rewritten by every `firebase deploy` so
# the next one can skip what has not changed. Nobody reads them and they carry
# no decision, but they are dirty after every deploy, and a dirty tracked file
# blocks `git checkout` — which is exactly how an 83-commit merge to main got
# stopped by three files describing when someone last uploaded privacy.html.
.firebase/hosting.*.cache

# ── iOS ──────────────────────────────────────────────────────────────────────
# SafeBeauty.xcodeproj is GENERATED from ios/project.yml by `make project`.
# Keeping it out of git is the point: a .pbxproj cannot be reviewed and cannot
# be merged, and committing it would put the project back in Xcode's hands
# rather than in a file anyone can read.
ios/SafeBeauty.xcodeproj/
ios/build/
ios/**/.build/
ios/DerivedData/
ios/**/*.xcuserdatad
# Generated by XcodeGen from project.yml, same as the project itself.
ios/SafeBeauty/Resources/Info.plist

# App Store Connect API keys. They live in ~/.appstoreconnect/private_keys/ and
# have no reason to be here — this is the same invariant as the Android
# keystore (I-13): signing material cannot be un-published once committed.
*.p8
