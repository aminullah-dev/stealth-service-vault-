{
  "name": "safebeauty-admin",
  "version": "1.0.0",
  "description": "SafeBeauty Admin — native desktop console (Mac / Windows)",
  "main": "main.js",
  "author": "SafeBeauty",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.safebeauty.admin",
    "productName": "SafeBeauty Admin",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "package.json"],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.business",
      "identity": null,
      "artifactName": "SafeBeauty-Admin-mac-${arch}.${ext}"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "SafeBeauty-Admin-win-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "SafeBeauty-Admin-linux-${arch}.${ext}"
    }
  }
}
